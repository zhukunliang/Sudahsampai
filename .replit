modules = ["python-3.12"]
run = "pip install -r requirements.txt && python src/app.py"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "vm"
build = ["pip", "install", "-r", "requirements.txt"]
run = ["python", "src/app.py"]
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 80
