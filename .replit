modules = ["python-3.12"]
run = "python -m venv .venv && PIP_USER=0 .venv/bin/pip install -q -r requirements.txt && .venv/bin/python src/app.py"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "python -m venv .venv && PIP_USER=0 .venv/bin/pip install -r requirements.txt"]
run = [".venv/bin/python", "src/app.py"]
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 80
